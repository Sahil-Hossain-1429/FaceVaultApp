{
  "expo": {
    "name": "FaceVaultApp",
    "slug": "facevault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "facevaultapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sahilh.FaceVaultApp",
      "infoPlist": {
        "NSCameraUsageDescription": "FaceVault needs your camera for facial recognition."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.sahilh.FaceVaultApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E172A",
          "image": "./assets/images/appLogo.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FaceVault needs access to your photos so you can add them to your vault.",
          "cameraPermission": "FaceVault needs camera access so you can capture and store new photos securely."
        }
      ],
      "expo-secure-store",
      "expo-image",
      "@clerk/expo",
      "expo-web-browser",
      "./app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "854ee992-a33e-4430-bb7b-18a9353d15bb"
      }
    },
    "owner": "sahilh"
  }
}